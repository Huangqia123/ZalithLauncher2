+object UpgradePrefs {
+    private val mmkv get() = launcherMMKV()
+
+    /**
+     * 上次检查更新的时间戳
+     */
+    var lastUpgradeCheck: Long
+        get() = mmkv.getLong("lastUpgradeCheck", 0L)
+        set(value) {
+            mmkv.putLong("lastUpgradeCheck", value).apply()
+        }
+
+    /**
+     * 用户选择忽略的更新版本号
+     */
+    var lastIgnoredVersion: Int?
+        get() = if (mmkv.containsKey("lastIgnoredVersion")) mmkv.getInt("lastIgnoredVersion", 0) else null
+        set(value) {
+            if (value == null) mmkv.remove("lastIgnoredVersion")
+            else mmkv.putInt("lastIgnoredVersion", value).apply()
+        }
+}
