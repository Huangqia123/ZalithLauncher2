+import com.movtery.zalithlauncher.game.account.auth_server.data.AuthServer
+
+/**
+ * BlockNest 内置认证服务器
+ *
+ * 目的：把常用的外置皮肤站直接放进账号登录列表，
+ * 玩家不必再手动「添加认证服务器」并填写 API 地址，登录时只输邮箱与密码即可。
+ */
+object BuiltInAuthServers {
+    /** LittleSkin（https://littleskin.cn），Yggdrasil API 地址已验证可用 */
+    val LITTLE_SKIN: AuthServer = AuthServer(
+        baseUrl = "https://littleskin.cn/api/yggdrasil",
+        serverName = "LittleSkin",
+        register = "https://littleskin.cn/auth/register"
+    )
+
+    /** 所有内置服务器 */
+    val all: List<AuthServer> = listOf(LITTLE_SKIN)
+
+    /**
+     * 判断该地址是否为内置服务器
+     */
+    fun isBuiltIn(baseUrl: String): Boolean {
+        return all.any { it.baseUrl == baseUrl }
+    }
+}
